# ==========================================
# NetSpot - Arquivo de Exemplo de Configuração (.env)
# IMPORTANTE: Copie para .env e preencha com senhas fortes.
# NUNCA versione senhas reais no controle de versão.
# ==========================================

# PostgreSQL - Credenciais e Banco
POSTGRES_USER=netspot
POSTGRES_PASSWORD=altere_para_uma_senha_forte_postgres
POSTGRES_DB=netspot
DATABASE_URL=postgresql://netspot:altere_para_uma_senha_forte_postgres@localhost:5432/netspot

# Segurança da API e Token JWT
NETSPOT_SECRET_KEY=altere_para_chave_secreta_longa_e_aleatoria
NETSPOT_DEFAULT_ADMIN_PASSWORD=altere_para_senha_segura_admin

# Mensageria (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Orquestração N8N
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=altere_para_uma_senha_forte_n8n

# Notificações via Telegram
NETSPOT_TELEGRAM_BOT_TOKEN=seu_telegram_bot_token
NETSPOT_TELEGRAM_CHAT_ID=seu_telegram_chat_id

# Parâmetros Operacionais de Monitoramento, Descoberta e Porta Web
COMPOSE_PROJECT_NAME=netspot
NETSPOT_PORT=8080
NETSPOT_DEFAULT_SUBNET=192.168.1.0/24
NETSPOT_MONITOR_INTERVAL_SECONDS=10
NETSPOT_RETENTION_DAYS=0
